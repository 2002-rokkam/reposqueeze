{
  "name": "reposqueeze-v2",
  "displayName": "RepoSqueeze V2",
  "description": "Robust, local repository context using perturbation-consensus retrieval for Copilot and MCP coding agents.",
  "version": "2.2.0",
  "publisher": "2002-rokkam",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "bin": {
    "reposqueeze-v2": "./dist/cli.cjs"
  },
  "files": [
    "dist/*.cjs",
    "assets",
    "skills",
    "README.md",
    "LICENSE",
    "docs/*.md",
    "third_party",
    "src",
    "scripts/build.mjs",
    "scripts/import-meta.js",
    "THIRD_PARTY_NOTICES.md",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "bench": "node --import tsx scripts/benchmark.ts",
    "bench:fetch": "node scripts/fetch-bench.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository -o releases/reposqueeze-v2-2.2.0.vsix",
    "prepare": "npm run build",
    "test:editor": "node scripts/test-extension.mjs",
    "bench:live": "node --import tsx scripts/live-eval.ts",
    "bench:formats": "node --import tsx scripts/format-benchmark.ts",
    "bench:v2:development": "node --import tsx scripts/benchmark-v2-arb.ts development",
    "bench:v2:test": "node --import tsx scripts/benchmark-v2-arb.ts test",
    "bench:v2:summary": "node --import tsx scripts/summarize-v2.ts",
    "bench:scale:development": "node --import tsx scripts/benchmark-scale.ts development",
    "bench:scale:test": "node --import tsx scripts/benchmark-scale.ts test"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "reposqueeze-v2.pack",
        "title": "RepoSqueeze V2: Build Context Pack"
      },
      {
        "command": "reposqueeze-v2.map",
        "title": "RepoSqueeze V2: Show Repository Map"
      },
      {
        "command": "reposqueeze-v2.setup",
        "title": "RepoSqueeze V2: Install Copilot Instructions"
      }
    ],
    "configuration": {
      "title": "RepoSqueeze V2",
      "properties": {
        "reposqueezeV2.tokenBudget": {
          "type": "number",
          "default": 3000,
          "minimum": 256,
          "maximum": 32000,
          "description": "Maximum o200k_base tokens in a context pack. Provider token counts may differ."
        },
        "reposqueezeV2.semanticModel": {
          "type": "string",
          "default": "",
          "description": "Optional local Ollama embedding model (for example all-minilm). Sends only the strongest lexical candidates to localhost:11434 and caches vectors outside the repository. Empty disables embeddings."
        },
        "reposqueezeV2.features": {
          "type": "string",
          "default": "",
          "description": "Advanced: feature switches such as \"-prf,-git\" (same syntax as the RSQ_FEATURES environment variable). Empty keeps the defaults."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "reposqueeze_v2_context",
        "displayName": "RepoSqueeze V2 Context",
        "modelDescription": "Find the code for a task, error or question. Returns verbatim, line-cited source excerpts within a token budget. Local, read-only, not exhaustive: expand before editing.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "reposqueezeV2",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "budget": {
              "type": "integer",
              "minimum": 256,
              "maximum": 32000
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "reposqueeze_v2_expand",
        "displayName": "RepoSqueeze V2 Expand",
        "modelDescription": "Read exact current source lines (one-based, inclusive) of one repository file.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "squeezeRead",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "end": {
              "type": "integer",
              "minimum": 1
            },
            "budget": {
              "type": "integer",
              "minimum": 256,
              "maximum": 32000
            }
          },
          "required": [
            "path",
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "reposqueeze_v2_map",
        "displayName": "RepoSqueeze V2 Map",
        "modelDescription": "Repository map; with path, the outline of that file; with query, definitions whose names match.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "squeezeMap",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "budget": {
              "type": "integer",
              "minimum": 256,
              "maximum": 32000
            }
          },
          "additionalProperties": false
        }
      }
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@toon-format/toon": "^4.4.0",
    "ignore": "^7.0.5",
    "js-tiktoken": "^1.0.21",
    "lossless-json": "^4.3.3",
    "web-tree-sitter": "^0.22.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "tree-sitter-wasms": "0.1.13",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/2002-rokkam/reposqueeze-v2.git"
  },
  "homepage": "https://github.com/2002-rokkam/reposqueeze-v2#readme",
  "bugs": {
    "url": "https://github.com/2002-rokkam/reposqueeze-v2/issues"
  }
}
