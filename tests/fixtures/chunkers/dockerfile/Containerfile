ARG BASE=gcr.io/distroless/static:nonroot
ARG VERSION=dev

FROM golang:1.22 AS build
ARG VERSION
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-X main.version=${VERSION}" -o /out/server ./cmd/server

FROM ${BASE}
COPY --from=build /out/server /server
ENTRYPOINT ["/server"]
